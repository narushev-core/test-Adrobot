# Keitaro
KEITARO_URL=https://keitaro.example.com
KEITARO_API_KEY=changeme
KEITARO_DOMAIN_ID=1
KEITARO_TRAFFIC_SOURCE_ID=1
KEITARO_TIMEOUT_SECONDS=10

# База данных (те же DB_* использует контейнер postgres в docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=adrobot
DB_PASSWORD=adrobot
DB_NAME=adrobot

# События
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_EVENTS_TOPIC=adrobot.events

# Планировщик синхронизации групп
GROUPS_SYNC_INTERVAL_MINUTES=30

# Outbox relay
OUTBOX_RELAY_INTERVAL_SECONDS=1
OUTBOX_RELAY_BATCH_SIZE=100

# Приложение
APP_CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
